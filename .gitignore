# Home2Home: PHP MVC / MySQL / XAMPP / Bootstrap 4.6.2
# Keep source, schema/migrations/seeds/procedures, docs and demo assets.

# Environment and machine-specific credentials (safe templates stay shareable)
.env
.env.*
!.env.example
!.env.sample
config.local.php
database.local.php
/config/*.local.php
auth.json
/secrets/
/credentials/
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# IDE / operating system
.idea/
.vscode/
*.iml
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Machine-local AI/MCP configuration
/.kilo/

# Runtime logs and temporary files: directories scoped to runtime locations
*.log
/logs/
/log/
/tmp/
/temp/
/cache/
/storage/logs/
/storage/cache/
/storage/tmp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# Reinstallable dependencies, if Composer/npm are introduced
/vendor/
/node_modules/
composer.phar
# Keep composer.json, composer.lock, package.json and npm/yarn/pnpm lockfiles.

# Generated test output
/coverage/
.phpunit.result.cache
.phpunit.cache/
# Local Python/browser-test tooling (keep test source and curated evidence)
__pycache__/
*.py[cod]
.pytest_cache/
/.venv/
/venv/
/test-results/
/playwright-report/
/blob-report/
# Generated UI/browser screenshots (retain reports and original design references)
/docs/ui-experience/**/*.png
/docs/figma/home-*.png
!/docs/figma/home-reference.png
/docs/screenshots/*.png
/docs/quality/screenshots/**/*.png
/docs/quality/visual/screenshots/**/*.png

# User uploads: preserve the empty directory; demo images belong in assets.
/public/uploads/*
!/public/uploads/.gitkeep

# Local database exports/backups; NEVER ignore all *.sql.
/database/backups/
/database/dumps/
/database/exports/
/backups/
/db-backups/
*.sql.gz
*.sql.bz2
*.sql.zip
*.sql.bak
*.dump
# Keep database/schema.sql, seed.sql, migrations/, procedures/ and setup scripts.
# Put private exports in the ignored directories above, not beside shared SQL.

# Optional local XAMPP installations
/xampp/
/phpmyadmin/

# No blanket rules for docs/, graph/, image/, build/ or dist/:
# preserve group diagrams, reports, design assets and any required deliverables.
