APP_ENV=local
APP_DEBUG=false
DEBUG_VERIFICATION_ENABLED=false

# Image CAPTCHA uses PHP GD and sessions; no API keys. See docs/captcha.md.

# Safe mail placeholders only. See docs/booking-emails.md for SMTP and worker setup.
# Never place SMTP passwords or real credentials in this shared template.
MAIL_ENABLED=false
MAIL_TRANSPORT=smtp
MAIL_FROM=
MAIL_FROM_NAME=Home2Home
MAIL_BASE_URL=http://127.0.0.1:8090
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_CA_FILE=
PASSWORD_RESET_BASE_URL=
# This value only fits the quick run at http://127.0.0.1:8090 (README step 5).
# Serving anywhere else (VirtualHost, htdocs, another port or machine)? Leave it empty: links then follow the address in use.
APP_URL=http://127.0.0.1:8090
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_home2home
DB_USERNAME=root
DB_PASSWORD=

# Geoapify Places: nearby restaurants, cafes and shops on listing detail pages.
# Obtain your own key at https://myprojects.geoapify.com/ and keep it in .env.
GEOAPIFY_API_KEY=

# Google OAuth: create a Web application client and register this exact callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8090/auth/google/callback

# Facebook Login: Meta App ID/Secret, not your Facebook password. See docs/facebook-auth.md.
# Temporarily disabled. Set true after configuring and testing the Meta app.
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8090/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v26.0


# Online payment (Nice-to-have). An empty group hides that method; never commit real values.
# VietQR receiving account: bank BIN or short name (list: https://api.vietqr.io/v2/banks), account number, holder name.
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
HOST_PAYOUT_SYSTEM_ADMIN_ID=
# VNPay sandbox merchant from http://sandbox.vnpayment.vn/devreg/ (the TMN code and hash secret arrive by email).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional absolute return address; empty = the address the Guest is browsing.
VNPAY_RETURN_URL=

# SMS verification via Twilio Verify. Email verification uses MAIL/SMTP settings above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
