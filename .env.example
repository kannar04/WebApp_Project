APP_ENV=local
APP_DEBUG=false

# Safe mail placeholders only. Configure PHP/XAMPP mail transport locally first.
# Never place SMTP passwords or real credentials in this shared template.
MAIL_ENABLED=false
MAIL_FROM=
PASSWORD_RESET_BASE_URL=
APP_URL=http://127.0.0.1:8090
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_home2home
DB_USERNAME=root
DB_PASSWORD=


# Online payment (Nice-to-have). An empty group hides that method; never commit real values.
# VietQR receiving account: bank BIN or short name (list: https://api.vietqr.io/v2/banks), account number, holder name.
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
# VNPay sandbox merchant from http://sandbox.vnpayment.vn/devreg/ (the TMN code and hash secret arrive by email).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional absolute return address; empty = the address the Guest is browsing.
VNPAY_RETURN_URL=
